# =============================================================================
# HelMoRo ROS 2 — Jetson Orin Nano Docker Image
# Based on NVIDIA L4T for native CUDA/GPU support on Jetson
# Hardware: BTS7960B + Pico 2W, IMX219-83 stereo, RPLiDAR A1M8, BNO055
# =============================================================================

# L4T R36.x = JetPack 6.x (Ubuntu 22.04 + CUDA) — adjust tag for your JetPack version
ARG L4T_VERSION=r36.2.0
FROM dustynv/ros:humble-ros-base-l4t-${L4T_VERSION} AS jetson-real

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

SHELL ["/bin/bash", "-c"]

# ── System utilities ─────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    tmux \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-serial \
    i2c-tools \
    libi2c-dev \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# ── ROS 2 dependencies ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ament-cmake \
    ros-${ROS_DISTRO}-ament-cmake-python \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclcpp-action \
    ros-${ROS_DISTRO}-rclcpp-components \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-urdf \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-diff-drive-controller \
    ros-${ROS_DISTRO}-joint-state-broadcaster \
    ros-${ROS_DISTRO}-ros2controlcli \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-twist-mux \
    ros-${ROS_DISTRO}-topic-tools \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-image-transport-plugins \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-ros2launch \
    ros-${ROS_DISTRO}-v4l2-camera \
    ros-${ROS_DISTRO}-stereo-image-proc \
    ros-${ROS_DISTRO}-image-pipeline \
    ros-${ROS_DISTRO}-camera-calibration \
    && rm -rf /var/lib/apt/lists/*

# ── Workspace setup ─────────────────────────────────────────────────────────
ENV HELMORO_WS=/ros2_ws
RUN mkdir -p ${HELMORO_WS}/src
WORKDIR ${HELMORO_WS}

# Copy source code
COPY . ${HELMORO_WS}/src/HelMoRo-software-ROS2/

# ── Clone external driver packages ──────────────────────────────────────────
WORKDIR ${HELMORO_WS}/src

# MPU9250 IMU driver (I2C)
RUN git clone https://github.com/hiwad-aziz/ros2_mpu9250_driver.git mpu9250driver

# RPLiDAR ROS 2 driver (supports A1, A2, A3, S1, S2)
RUN git clone https://github.com/Slamtec/rplidar_ros.git -b ${ROS_DISTRO}

# ── Install remaining rosdep keys ───────────────────────────────────────────
WORKDIR ${HELMORO_WS}
RUN apt-get update \
    && rosdep update --rosdistro=${ROS_DISTRO} \
    && rosdep install --from-paths src --ignore-src -y \
       --skip-keys="mpu9250driver ign_ros2_control ros_gz ros_gz_sim ros_gz_bridge ros_ign ros_ign_bridge ros_ign_gazebo ros_ign_interfaces" \
       2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/*

# ── Build workspace (real robot packages only, no Gazebo) ────────────────────
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build \
        --symlink-install \
        --packages-ignore \
            helmoro_sim_bringup \
            helmoro_gazebo_tools \
            helmoro_motors \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build/*/CMakeFiles log/

# ── Entrypoint ───────────────────────────────────────────────────────────────
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["ros2", "launch", "helmoro_real_bringup", "helmoro_launch.py"]
